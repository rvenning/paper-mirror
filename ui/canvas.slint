// The document canvas: a virtualised page surface. Rust computes which pages are in
// view and where they sit; this file only draws what it is given and reports pointer
// input back in content coordinates.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BridgedTextInput } from "controls.slint";
import { FormLayer, FormFieldView } from "forms.slint";

export struct PageItem {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    has-image: bool,
    // High-zoom detail tile covering only the visible part of the page.
    tile: image,
    has-tile: bool,
    tile-x: length,
    tile-y: length,
    tile-width: length,
    tile-height: length,
    label: string,
    // The page's text once extracted (empty until then, or for scans and images),
    // so a screen reader can read it.
    text: string,
}

// kind: 0 search match, 1 current search match, 2 text selection, 3 rectangular
// selection, 4 drag insertion marker.
export struct OverlayRect {
    x: length,
    y: length,
    width: length,
    height: length,
    kind: int,
}

// One drawing primitive of an annotation, in content coordinates.
// kind: 0 stroked path, 1 filled path, 2 text, 3 loupe image.
export struct AnnotPrim {
    kind: int,
    x: length,
    y: length,
    width: length,
    height: length,
    commands: string,
    color: color,
    stroke-width: length,
    text: string,
    font-family: string,
    font-size: length,
    align: int,
    image: image,
    label: string,
}

export struct SheetItem {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    has-image: bool,
    label: string,
    selected: bool,
}

export component Canvas inherits Rectangle {
    in property <[PageItem]> pages;
    in property <[OverlayRect]> overlays;
    in property <length> content-width;
    in property <length> content-height;
    out property <length> scroll-x: -flick.content-x;
    out property <length> scroll-y: -flick.content-y;
    in property <string> empty-title;
    in property <string> empty-detail;
    in property <bool> has-document;
    // "default", "pointer", "text", "crosshair", "move", "grab" or "grabbing".
    in property <string> cursor: "default";
    in property <bool> loupe-visible;
    in property <image> loupe-image;
    in property <length> loupe-x;
    in property <length> loupe-y;
    in property <length> loupe-size: 220px;
    // Instant Alpha selection overlay (content coordinates).
    // 3D view: the wheel zooms without Ctrl.
    in property <bool> zoom-on-wheel;
    in property <bool> mask-visible;
    in property <image> mask-image;
    in property <length> mask-x;
    in property <length> mask-y;
    in property <length> mask-w;
    in property <length> mask-h;
    out property <length> view-width: flick.visible-width;
    out property <length> view-height: flick.visible-height;
    out property <bool> hovered: wheel.has-hover || draw-layer.has-hover;
    in property <bool> can-copy;
    callback context-command(id: string);
    in property <[AnnotPrim]> annot-prims;
    in property <bool> annot-selected;
    in property <bool> annot-resizable;
    in property <length> sel-x;
    in property <length> sel-y;
    in property <length> sel-w;
    in property <length> sel-h;
    in property <bool> editing;
    in property <bool> edit-note;
    in property <length> edit-x;
    in property <length> edit-y;
    in property <length> edit-w;
    in property <length> edit-h;
    in-out property <string> edit-text;
    in property <length> edit-font-size: 14px;
    in property <string> edit-font;
    in property <color> edit-color: black;
    in property <int> edit-align;
    callback edit-finished(text: string);
    in property <[FormFieldView]> form-fields;
    callback field-commit-text(index: int, text: string);
    callback field-toggle(index: int);
    callback field-choose(index: int, option: int);
    callback field-sign(index: int);

    callback viewport-changed();
    callback ctrl-wheel(delta: float, x: length, y: length);
    callback key(event: KeyEvent) -> bool;
    // kind: 0 down, 1 move, 2 up, 3 cancel, 4 double-click. button: 0 left, 1 right.
    callback pointer(kind: int, x: length, y: length, shift: bool, ctrl: bool, button: int);
    // Touch: one finger pans the page (the ScrollView does that) unless `touch-draws`,
    // when a markup tool or the 3D view wants single-finger input and the layer above
    // the ScrollView takes it. Two fingers always pinch to zoom and pan.
    // phase: 0 started, 1 updated, 2 ended, 3 cancelled; x, y in the viewport.
    in property <bool> touch-draws;
    callback pinch(phase: int, scale: float, x: length, y: length);

    property <MouseCursor> pointer-cursor: root.cursor == "pointer" ? MouseCursor.pointer : root.cursor == "text" ? MouseCursor.text : root.cursor == "crosshair" ? MouseCursor.crosshair : root.cursor == "move" ? MouseCursor.move : root.cursor == "grab" ? MouseCursor.grab : root.cursor == "grabbing" ? MouseCursor.grabbing : MouseCursor.default;

    background: Theme.canvas-bg;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Document";

    changed width => { root.viewport-changed(); }
    changed height => { root.viewport-changed(); }

    // Pinch gestures reach this wrapper after the item holding the pointer grab (the
    // first finger) has ignored them, so it must enclose everything else.
    ScaleRotateGestureHandler {
        width: 100%;
        height: 100%;
        enabled: root.has-document;
        started => { root.pinch(0, self.scale, self.center.x, self.center.y); }
        updated => { root.pinch(1, self.scale, self.center.x, self.center.y); }
        ended => { root.pinch(2, self.scale, self.center.x, self.center.y); }
        cancelled => { root.pinch(3, self.scale, self.center.x, self.center.y); }

        flick := ScrollView {
            content-width: root.content-width;
            content-height: root.content-height;
            // Flickable offsets are negative; scroll-x/scroll-y expose positive offsets.
            changed content-x => { root.viewport-changed(); }
            changed content-y => { root.viewport-changed(); }

            for p in root.pages: Rectangle {
                x: p.x;
                y: p.y;
                width: p.width;
                height: p.height;
                background: white;
                border-width: 1px;
                border-color: Theme.page-border;
                // Narrator reads a page as "Page 1 of 3." followed by its text.
                accessible-role: text;
                accessible-label: p.text != "" ? p.label + ". " + p.text : p.label;
                if p.has-image: Image {
                    width: parent.width;
                    height: parent.height;
                    source: p.image;
                    image-fit: fill;
                    image-rendering: smooth;
                    accessible-role: none;
                }
                if p.has-tile: Image {
                    accessible-role: none;
                    x: p.tile-x;
                    y: p.tile-y;
                    width: p.tile-width;
                    height: p.tile-height;
                    source: p.tile;
                    image-fit: fill;
                }
            }

            for a in root.annot-prims: Rectangle {
                x: a.x;
                y: a.y;
                width: a.width;
                height: a.height;
                accessible-role: image;
                accessible-label: a.label;
                if a.kind == 0: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    commands: a.commands;
                    stroke: a.color;
                    stroke-width: a.stroke-width;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
                if a.kind == 1: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    commands: a.commands;
                    fill: a.color;
                    stroke: transparent;
                }
                if a.kind == 2: Text {
                    width: parent.width;
                    height: parent.height;
                    text: a.text;
                    font-family: a.font-family;
                    font-size: a.font-size;
                    color: a.color;
                    vertical-alignment: top;
                    horizontal-alignment: a.align == 1 ? TextHorizontalAlignment.center : a.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                }
                if a.kind == 3: Rectangle {
                    border-radius: self.width / 2;
                    clip: true;
                    background: white;
                    Image { width: parent.width; height: parent.height; source: a.image; image-fit: fill; }
                }
            }

            for o in root.overlays: Rectangle {
                x: o.x;
                y: o.y;
                width: o.width;
                height: o.height;
                background: o.kind == 0 ? Theme.search-match : o.kind == 1 ? Theme.search-current : o.kind == 2 ? Theme.selection : o.kind == 3 ? Theme.selection.with-alpha(0.12) : Theme.accent;
                border-width: o.kind == 3 ? 1px : 0px;
                border-color: Theme.accent;
            }

            wheel := TouchArea {
                width: max(root.content-width, flick.visible-width);
                height: max(root.content-height, flick.visible-height);
                mouse-cursor: root.pointer-cursor;
                scroll-event(e) => {
                    if e.modifiers.control || root.zoom-on-wheel {
                        root.ctrl-wheel(e.delta-y / 1px, self.mouse-x - root.scroll-x, self.mouse-y - root.scroll-y);
                        return accept;
                    }
                    reject
                }
                pointer-event(e) => {
                    if e.button == PointerEventButton.middle { return; }
                    if e.kind == PointerEventKind.down { focus.focus(); }
                    root.pointer(
                        e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.move ? 1 : e.kind == PointerEventKind.up ? 2 : 3,
                        self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control,
                        e.button == PointerEventButton.right ? 1 : 0);
                }
                double-clicked => {
                    root.pointer(4, self.mouse-x, self.mouse-y, false, false, 0);
                }
            }
        }

        // While `touch-draws`, pointer input is taken here, above the ScrollView, so a
        // finger draws instead of panning. Coordinates go out in content space, as from
        // `wheel`. Plain wheel events fall through to the ScrollView.
        draw-layer := TouchArea {
            enabled: root.touch-draws && root.has-document;
            width: flick.visible-width;
            height: flick.visible-height;
            mouse-cursor: root.pointer-cursor;
            scroll-event(e) => {
                if e.modifiers.control || root.zoom-on-wheel {
                    root.ctrl-wheel(e.delta-y / 1px, self.mouse-x, self.mouse-y);
                    return accept;
                }
                reject
            }
            pointer-event(e) => {
                if e.button == PointerEventButton.middle { return; }
                if e.kind == PointerEventKind.down { focus.focus(); }
                root.pointer(
                    e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.move ? 1 : e.kind == PointerEventKind.up ? 2 : 3,
                    self.mouse-x + root.scroll-x, self.mouse-y + root.scroll-y, e.modifiers.shift, e.modifiers.control,
                    e.button == PointerEventButton.right ? 1 : 0);
            }
            double-clicked => {
                root.pointer(4, self.mouse-x + root.scroll-x, self.mouse-y + root.scroll-y, false, false, 0);
            }
        }

        // Selection frame, handles and the text editor sit above the page content but
        // inside the scrolled coordinate space.
        Rectangle {
            x: -root.scroll-x;
            y: -root.scroll-y;
            width: root.content-width;
            height: root.content-height;
            if root.mask-visible: Image {
                x: root.mask-x;
                y: root.mask-y;
                width: root.mask-w;
                height: root.mask-h;
                source: root.mask-image;
                image-fit: fill;
                image-rendering: pixelated;
                accessible-role: none;
            }
            FormLayer {
                fields: root.form-fields;
                commit-text(i, t) => { root.field-commit-text(i, t); }
                toggle(i) => { root.field-toggle(i); }
                choose(i, o) => { root.field-choose(i, o); }
                sign(i) => { root.field-sign(i); }
            }
            if root.annot-selected: Rectangle {
                x: root.sel-x;
                y: root.sel-y;
                width: root.sel-w;
                height: root.sel-h;
                border-width: 1px;
                border-color: Theme.accent;
                for h in root.annot-resizable ? [
                    { x: 0, y: 0 }, { x: 0.5, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 0.5 },
                    { x: 1, y: 1 }, { x: 0.5, y: 1 }, { x: 0, y: 1 }, { x: 0, y: 0.5 },
                ] : []: Rectangle {
                    x: h.x * parent.width - 4px;
                    y: h.y * parent.height - 4px;
                    width: 8px;
                    height: 8px;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.accent;
                }
            }
            if root.editing: Rectangle {
                x: root.edit-x;
                y: root.edit-y;
                width: root.edit-w;
                height: root.edit-h;
                background: root.edit-note ? #fff7c2 : #ffffffe6;
                border-width: 1px;
                border-color: Theme.accent;
                drop-shadow-blur: root.edit-note ? 8px : 0px;
                drop-shadow-color: #00000040;
                editor := BridgedTextInput {
                    x: 4px;
                    y: 3px;
                    width: parent.width - 8px;
                    height: parent.height - 6px;
                    text <=> root.edit-text;
                    font-size: root.edit-font-size;
                    font-family: root.edit-font;
                    color: root.edit-color;
                    single-line: false;
                    wrap: word-wrap;
                    horizontal-alignment: root.edit-align == 1 ? TextHorizontalAlignment.center : root.edit-align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    accessible-label: root.edit-note ? "Note text" : "Text box";
                    init => { self.focus(); self.select-all(); }
                    key-pressed(e) => {
                        if e.text == Key.Escape { root.edit-finished(self.text); return accept; }
                        reject
                    }
                    changed has-focus => {
                        if !self.has-focus { root.edit-finished(self.text); }
                    }
                }
            }
        }

        // On top of the scroll view: it accepts only right-clicks, everything else falls
        // through to the pointer TouchArea underneath.
        ContextMenuArea {
            width: flick.visible-width;
            height: flick.visible-height;
            enabled: root.has-document;
            Menu {
                MenuItem { title: "Copy"; enabled: root.can-copy; activated => { root.context-command("copy"); } }
                MenuItem { title: "Select All"; activated => { root.context-command("select-all"); } }
                MenuSeparator { }
                MenuItem { title: "Zoom In"; activated => { root.context-command("zoom-in"); } }
                MenuItem { title: "Zoom Out"; activated => { root.context-command("zoom-out"); } }
                MenuItem { title: "Actual Size"; activated => { root.context-command("zoom-actual"); } }
                MenuItem { title: "Zoom to Fit"; activated => { root.context-command("zoom-fit-page"); } }
            }
        }

        if root.loupe-visible: Rectangle {
            x: root.loupe-x - root.loupe-size / 2;
            y: root.loupe-y - root.loupe-size / 2;
            width: root.loupe-size;
            height: root.loupe-size;
            border-radius: root.loupe-size / 2;
            clip: true;
            background: white;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.loupe-image;
                image-fit: fill;
            }
            Rectangle {
                border-radius: root.loupe-size / 2;
                border-width: 3px;
                border-color: Theme.dark ? #c8c8c8 : #555555;
            }
        }

        if !root.has-document: VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: root.empty-title;
                color: Theme.text-secondary;
                font-size: 18px;
                horizontal-alignment: center;
            }
            Text {
                text: root.empty-detail;
                color: Theme.text-secondary;
                font-size: Theme.font-size;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        focus := FocusScope {
            // Clicks belong to the controls underneath, which take focus themselves; a
            // FocusScope that focuses on click would swallow the first press.
            focus-on-click: false;
            key-pressed(e) => { root.key(e) ? accept : reject }
        }
    }

    public function scroll-to(x: length, y: length) {
        flick.content-x = -x;
        flick.content-y = -y;
    }

    public function focus-canvas() {
        focus.focus();
    }
}

// Contact sheet: a grid of large thumbnails replacing the canvas.
export component ContactSheet inherits Rectangle {
    in property <[SheetItem]> items;
    in property <length> content-height;
    out property <length> scroll-y: -scroll.content-y;
    out property <length> view-width: scroll.visible-width;
    out property <length> view-height: scroll.visible-height;
    callback viewport-changed();
    callback item-clicked(index: int);
    callback item-opened(index: int);
    background: Theme.canvas-bg;
    accessible-role: list;
    accessible-label: "Contact sheet";
    changed width => { root.viewport-changed(); }
    changed height => { root.viewport-changed(); }
    scroll := ScrollView {
        content-height: root.content-height;
        content-width: self.visible-width;
        changed content-y => { root.viewport-changed(); }
        for t in root.items: Rectangle {
            x: t.x;
            y: t.y;
            width: t.width + 16px;
            height: t.height + 34px;
            accessible-role: list-item;
            accessible-label: t.label;
            accessible-item-selectable: true;
            accessible-item-selected: t.selected;
            accessible-action-default => { root.item-opened(t.index); }
            Rectangle {
                width: t.width + 12px;
                height: t.height + 12px;
                x: 2px;
                y: 2px;
                border-radius: 6px;
                background: t.selected ? Theme.control-selected : transparent;
            }
            Rectangle {
                x: 8px;
                y: 8px;
                width: t.width;
                height: t.height;
                background: white;
                border-width: 1px;
                border-color: Theme.page-border;
                if t.has-image: Image { source: t.image; width: parent.width; height: parent.height; image-fit: fill; }
            }
            Text {
                y: t.height + 16px;
                width: parent.width;
                text: t.label;
                horizontal-alignment: center;
                font-size: Theme.font-small;
                color: Theme.text-secondary;
            }
            TouchArea {
                clicked => { root.item-clicked(t.index); }
                double-clicked => { root.item-opened(t.index); }
            }
        }
    }
}
