// Paper Mirror design tokens. Light and dark values follow the quiet, neutral
// treatment of macOS Preview while using Windows-appropriate type and metrics.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Set from Rust: "system" follows Palette.color-scheme; "light"/"dark" force.
    in-out property <string> appearance: "system";
    out property <bool> dark: appearance == "dark" || (appearance == "system" && Palette.color-scheme == ColorScheme.dark);

    // Surfaces
    out property <color> window-bg: dark ? #1f1f1f : #f3f3f3;
    out property <color> toolbar-bg: dark ? #2b2b2b : #ececec;
    out property <color> toolbar-border: dark ? #3c3c3c : #d4d4d4;
    out property <color> sidebar-bg: dark ? #252525 : #e9e9e9;
    out property <color> canvas-bg: dark ? #1b1b1b : #dcdcdc;
    out property <color> page-border: dark ? #00000080 : #00000030;
    out property <color> panel-bg: dark ? #2d2d2d : #fbfbfb;
    out property <color> separator: dark ? #3d3d3d : #d0d0d0;

    // Text
    out property <color> text: dark ? #ececec : #1d1d1d;
    out property <color> text-secondary: dark ? #a8a8a8 : #6b6b6b;
    out property <color> text-disabled: dark ? #6a6a6a : #a8a8a8;

    // Controls
    out property <color> control-hover: dark ? #ffffff14 : #0000000d;
    out property <color> control-pressed: dark ? #ffffff24 : #0000001a;
    out property <color> control-selected: dark ? #ffffff2a : #00000021;
    out property <color> accent: dark ? #4c9aff : #0a64d6;
    out property <color> accent-text: #ffffff;
    out property <color> focus-ring: dark ? #8ab8ff : #0a64d6;
    out property <color> selection: dark ? #4c9aff55 : #0a64d640;
    out property <color> search-match: #ffd60a80;
    out property <color> search-current: #ff9f0aa0;
    out property <color> warning: dark ? #ffcc4d : #9a6700;
    out property <color> error: dark ? #ff7b72 : #c62828;
    out property <color> field-bg: dark ? #1e1e1e : #ffffff;
    out property <color> field-border: dark ? #4a4a4a : #c4c4c4;

    // Metrics
    out property <length> toolbar-height: 46px;
    out property <length> markupbar-height: 38px;
    out property <length> icon-button-size: 30px;
    out property <length> radius: 6px;
    out property <length> sidebar-min: 120px;
    out property <length> sidebar-max: 420px;
    out property <length> font-size: 13px;
    out property <length> font-small: 11px;
    out property <length> font-title: 13px;
    out property <duration> motion-fast: 90ms;
}
