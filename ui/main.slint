// Paper Mirror main document window.
import { AboutSlint, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { IconButton, Segmented, ToolbarSeparator, PlainButton, Tooltip, EditBridge, BridgedLineEdit } from "controls.slint";
import { Canvas, PageItem, OverlayRect, ContactSheet, SheetItem, AnnotPrim } from "canvas.slint";
import { MarkupBar } from "markup.slint";
import { ThumbnailList, ThumbItem, RowList, ListRow, SidebarTabs } from "sidebar.slint";
import { Scrim, PromptPanel, ShortcutsPanel, ShortcutRow, ExportPanel } from "dialogs.slint";
import { InspectorPanel, InfoRow } from "inspector.slint";
import { SlideshowWindow } from "slideshow.slint";
import { FormFieldView, SignatureView, SignaturesPanel } from "forms.slint";
import { AdjustSizePanel, AdjustColorPanel } from "imagetools.slint";

export { Theme, EditBridge, AnnotPrim, FormFieldView, SignatureView, PageItem, ThumbItem, ListRow, ShortcutRow, OverlayRect, SheetItem, InfoRow, SlideshowWindow }

export component MainWindow inherits Window {
    // Document state
    in property <string> doc-title: "Paper Mirror";
    in property <string> doc-subtitle;
    in property <bool> has-document;
    in property <bool> has-file;
    in property <bool> edited;
    in property <bool> multi-page;
    in property <string> zoom-label;
    in property <string> app-version;
    in property <string> display-mode: "continuous";
    in property <[string]> recent-files;
    in property <[string]> window-titles;
    in property <int> window-index;
    in property <string> tool: "tool-text";
    in property <bool> loupe-on;
    in property <bool> has-rect-selection;
    in property <bool> page-bookmarked;
    in property <bool> has-text-selection;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> busy-text;
    // Images (ADR 0007)
    in property <bool> is-image;
    in property <bool> is-model;
    in property <bool> has-location;
    in property <bool> location-shown;
    in property <bool> location-removed;
    in property <bool> mask-visible;
    in property <image> mask-image;
    in property <length> mask-x;
    in property <length> mask-y;
    in property <length> mask-w;
    in property <length> mask-h;
    in-out property <bool> size-visible;
    in property <[string]> size-units;
    in-out property <int> size-unit;
    in-out property <string> size-width;
    in-out property <string> size-height;
    in-out property <string> size-resolution;
    in-out property <bool> size-proportional: true;
    in-out property <bool> size-resample: true;
    in property <bool> size-editable: true;
    in property <string> size-result;
    in-out property <bool> adjust-visible;
    in-out property <float> adjust-black;
    in-out property <float> adjust-white: 1;
    in-out property <float> adjust-exposure;
    in-out property <float> adjust-contrast;
    in-out property <float> adjust-saturation: 1;
    in-out property <float> adjust-temperature;
    in-out property <float> adjust-tint;
    in-out property <float> adjust-sepia;
    in-out property <float> adjust-sharpness;

    // Markup
    in-out property <bool> markup-visible;
    in property <color> markup-stroke: #e5484d;
    in property <color> markup-fill: white;
    in property <bool> markup-fill-none: true;
    in property <float> markup-line-width: 2;
    in property <bool> markup-dashed;
    in property <[string]> markup-fonts;
    in property <string> markup-font: "Arial";
    in property <float> markup-font-size: 14;
    in property <color> markup-text-color: black;
    in property <int> markup-align;
    in property <[AnnotPrim]> annot-prims;
    in property <bool> annot-selected;
    in property <bool> annot-resizable;
    in property <length> sel-x;
    in property <length> sel-y;
    in property <length> sel-w;
    in property <length> sel-h;
    in property <bool> editing;
    in property <bool> edit-note;
    in property <length> edit-x;
    in property <length> edit-y;
    in property <length> edit-w;
    in property <length> edit-h;
    in-out property <string> edit-text;
    in property <length> edit-font-size: 14px;
    in property <string> edit-font: "Arial";
    in property <color> edit-color: black;
    in property <int> edit-align;
    in property <[ListRow]> note-rows;

    // Forms and signatures
    in property <[FormFieldView]> form-fields;
    in-out property <bool> signatures-visible;
    in property <[SignatureView]> signatures;
    in property <bool> sig-drawing;
    in property <string> pad-commands;
    in-out property <string> sig-name;

    // Canvas
    in property <[PageItem]> pages;
    in property <[OverlayRect]> overlays;
    in property <length> content-width;
    in property <length> content-height;
    in property <string> canvas-cursor: "default";
    in property <bool> loupe-visible;
    in property <image> loupe-image;
    in property <length> loupe-x;
    in property <length> loupe-y;
    out property <length> scroll-x: canvas.scroll-x;
    out property <length> scroll-y: canvas.scroll-y;
    out property <length> view-width: contact-sheet ? sheet.view-width : canvas.view-width;
    out property <length> view-height: contact-sheet ? sheet.view-height : canvas.view-height;

    // Contact sheet
    in-out property <bool> contact-sheet;
    in property <[SheetItem]> sheet-items;
    in property <length> sheet-content-height;
    out property <length> sheet-scroll-y: sheet.scroll-y;

    // Sidebar
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 170px;
    in-out property <string> sidebar-mode: "thumbnails";
    in property <[ThumbItem]> thumbs;
    in property <length> thumbs-content-height;
    out property <length> thumbs-scroll-y: thumbs.scroll-y;
    out property <length> thumbs-view-height: thumbs.view-height;
    out property <length> thumbs-view-width: thumbs.view-width;
    in property <bool> thumb-drop-visible;
    in property <length> thumb-drop-y;
    in property <bool> locked;

    // Export panel
    in-out property <bool> export-visible;
    in property <string> export-title: "Export";
    in property <[string]> export-formats;
    in-out property <int> export-format;
    in property <bool> export-is-pdf: true;
    in property <bool> export-has-quality;
    in-out property <float> export-quality: 90;
    in property <bool> export-has-resolution;
    in-out property <string> export-resolution: "150";
    in property <[string]> export-effects;
    in-out property <int> export-effect;
    in-out property <bool> export-reduce;
    in-out property <bool> export-encrypt;
    in-out property <bool> export-flatten;
    in-out property <string> export-password;
    in-out property <string> export-password2;
    in property <string> export-error;
    in property <[ListRow]> outline-rows;
    in property <[ListRow]> bookmark-rows;
    in property <[ListRow]> search-rows;
    in property <string> search-status;
    in property <bool> has-search;
    in-out property <string> search-text;

    // Inspector
    in-out property <bool> inspector-visible;
    in property <[InfoRow]> info-rows;

    // Modal prompt (password, Go to Page)
    in-out property <string> prompt-kind;
    in property <string> prompt-heading;
    in property <string> prompt-message;
    in property <string> prompt-error;
    in property <bool> prompt-password;
    in property <string> prompt-accept-label: "OK";
    in-out property <string> prompt-value;
    in-out property <bool> shortcuts-visible;
    in property <[ShortcutRow]> shortcut-rows;

    callback command(id: string);
    callback open-recent(index: int);
    callback activate-window(index: int);
    callback prompt-accepted(kind: string, value: string);
    callback prompt-cancelled(kind: string);
    callback canvas-viewport-changed();
    callback canvas-ctrl-wheel(delta: float, x: length, y: length);
    callback canvas-pinch(phase: int, scale: float, x: length, y: length);
    // Light/dark changed (setting or system): Rust repaints the title and menu bars.
    callback theme-changed();
    property <bool> theme-dark: Theme.dark;
    changed theme-dark => { root.theme-changed(); }
    callback canvas-key(event: KeyEvent) -> bool;
    callback canvas-pointer(kind: int, x: length, y: length, shift: bool, ctrl: bool, button: int);
    callback thumbs-viewport-changed();
    callback thumb-clicked(index: int, ctrl: bool, shift: bool);
    callback thumbs-key(event: KeyEvent) -> bool;
    callback sidebar-resized();
    callback sidebar-mode-selected(mode: string);
    callback list-row-clicked(mode: string, id: int);
    callback list-row-toggled(mode: string, id: int);
    callback search-submitted(text: string);
    callback search-edited(text: string);
    callback sheet-viewport-changed();
    callback sheet-item-clicked(index: int);
    callback sheet-item-opened(index: int);
    callback edit-finished(text: string);
    callback markup-set-stroke(c: color);
    callback markup-set-fill(c: color, none: bool);
    callback markup-set-line(width: float, dashed: bool);
    callback markup-set-text-style(font: string, size: float, color: color, align: int);
    callback field-commit-text(index: int, text: string);
    callback field-toggle(index: int);
    callback field-choose(index: int, option: int);
    callback field-sign(index: int);
    callback signature-chosen(id: int);
    callback signature-delete(id: int);
    callback signature-start-drawing();
    callback signature-import();
    callback pad-pointer(kind: int, x: length, y: length);
    callback pad-clear();
    callback pad-save();
    callback signatures-closed();
    callback thumb-drag(index: int, y: length);
    callback thumb-drop();
    callback export-confirm();
    callback export-format-changed();
    callback size-edited(field: string);
    callback size-confirm();
    callback size-cancel();
    callback adjust-changed();
    callback adjust-auto();
    callback adjust-reset();
    callback adjust-done();

    title: has-document ? (edited ? doc-title + " — Edited" : doc-title) : "Paper Mirror";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1100px;
    preferred-height: 820px;
    min-width: 560px;
    min-height: 380px;
    background: Theme.window-bg;
    // Windows 11's UI typeface; Slint falls back to its default font where it is missing.
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New from Clipboard"; shortcut: @keys(Control + "n"); activated => { root.command("new-from-clipboard"); } }
            MenuItem { title: "Open…"; shortcut: @keys(Control + "o"); activated => { root.command("open"); } }
            Menu {
                title: "Open Recent";
                for f[i] in root.recent-files: MenuItem { title: f; activated => { root.open-recent(i); } }
                MenuSeparator { }
                MenuItem { title: "Clear Menu"; enabled: root.recent-files.length > 0; activated => { root.command("clear-recent"); } }
            }
            MenuSeparator { }
            MenuItem { title: "Save"; shortcut: @keys(Control + "s"); enabled: root.has-document; activated => { root.command("save"); } }
            MenuItem { title: "Save As…"; shortcut: @keys(Control + Shift + "s"); enabled: root.has-document; activated => { root.command("save-as"); } }
            MenuItem { title: "Duplicate"; enabled: root.has-document; activated => { root.command("duplicate"); } }
            MenuItem { title: "Export…"; enabled: root.has-document; activated => { root.command("export"); } }
            MenuItem { title: "Export as PDF…"; enabled: root.has-document; activated => { root.command("export-pdf"); } }
            Menu {
                title: "Revert To";
                enabled: root.has-file;
                MenuItem { title: "Last Saved Version"; activated => { root.command("revert-saved"); } }
                MenuItem { title: "Original"; activated => { root.command("revert-original"); } }
            }
            MenuItem { title: root.locked ? "Unlock" : "Lock"; enabled: root.has-file; activated => { root.command("lock"); } }
            MenuSeparator { }
            MenuItem { title: "Show in File Explorer"; enabled: root.has-file; activated => { root.command("show-in-explorer"); } }
            MenuSeparator { }
            MenuItem { title: "Share…"; enabled: root.has-document; activated => { root.command("share"); } }
            MenuItem { title: "Print…"; shortcut: @keys(Control + "p"); enabled: root.has-document; activated => { root.command("print"); } }
            MenuSeparator { }
            MenuItem { title: "Close Window"; shortcut: @keys(Control + "w"); activated => { root.command("close"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: @keys(Control + "z"); enabled: EditBridge.field-focused || root.can-undo; activated => { root.command("undo"); } }
            MenuItem { title: "Redo"; shortcut: @keys(Control + Shift + "z"); enabled: EditBridge.field-focused || root.can-redo; activated => { root.command("redo"); } }
            MenuSeparator { }
            MenuItem { title: "Copy"; shortcut: @keys(Control + "c"); enabled: EditBridge.field-focused || root.has-text-selection || root.has-rect-selection; activated => { root.command("copy"); } }
            MenuItem { title: "Select All"; shortcut: @keys(Control + "a"); enabled: EditBridge.field-focused || root.has-document; activated => { root.command("select-all"); } }
            MenuItem { title: "Delete"; enabled: root.annot-selected; activated => { root.command("delete"); } }
            MenuItem { title: "Delete Pages"; enabled: root.has-document && root.multi-page; activated => { root.command("delete-pages"); } }
            Menu {
                title: "Insert";
                enabled: root.has-document && !root.is-image;
                MenuItem { title: "Blank Page"; activated => { root.command("insert-blank"); } }
                MenuItem { title: "Pages from File…"; activated => { root.command("insert-file"); } }
            }
            MenuSeparator { }
            MenuItem { title: "Find…"; shortcut: @keys(Control + "f"); enabled: root.has-document; activated => { root.command("find"); } }
            MenuItem { title: "Find Next"; shortcut: @keys(Control + "g"); enabled: root.has-search; activated => { root.command("find-next"); } }
            MenuItem { title: "Find Previous"; shortcut: @keys(Control + Shift + "g"); enabled: root.has-search; activated => { root.command("find-prev"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Content Only"; shortcut: @keys(Control + Alt + "1"); activated => { root.command("content-only"); } }
            MenuItem { title: "Thumbnails"; shortcut: @keys(Control + Alt + "2"); enabled: root.has-document; activated => { root.command("sidebar-thumbnails"); } }
            MenuItem { title: "Table of Contents"; shortcut: @keys(Control + Alt + "3"); enabled: root.has-document; activated => { root.command("sidebar-contents"); } }
            MenuItem { title: "Highlights and Notes"; shortcut: @keys(Control + Alt + "4"); enabled: root.has-document; activated => { root.command("sidebar-notes"); } }
            MenuItem { title: "Bookmarks"; shortcut: @keys(Control + Alt + "5"); enabled: root.has-document; activated => { root.command("sidebar-bookmarks"); } }
            MenuItem { title: "Contact Sheet"; shortcut: @keys(Control + Alt + "6"); checkable: true; checked: root.contact-sheet; enabled: root.has-document; activated => { root.command("contact-sheet"); } }
            MenuItem { title: root.sidebar-visible ? "Hide Sidebar" : "Show Sidebar"; shortcut: @keys(Control + Alt + "s"); activated => { root.command("toggle-sidebar"); } }
            MenuSeparator { }
            MenuItem { title: "Continuous Scroll"; shortcut: @keys(Control + "1"); checkable: true; checked: root.display-mode == "continuous"; enabled: root.has-document; activated => { root.command("view-continuous"); } }
            MenuItem { title: "Single Page"; shortcut: @keys(Control + "2"); checkable: true; checked: root.display-mode == "single"; enabled: root.has-document; activated => { root.command("view-single"); } }
            MenuItem { title: "Two Pages"; shortcut: @keys(Control + "3"); checkable: true; checked: root.display-mode == "two-pages"; enabled: root.has-document; activated => { root.command("view-two-pages"); } }
            MenuSeparator { }
            MenuItem { title: "Actual Size"; shortcut: @keys(Control + "0"); enabled: root.has-document; activated => { root.command("zoom-actual"); } }
            MenuItem { title: "Zoom to Fit"; shortcut: @keys(Control + "9"); enabled: root.has-document; activated => { root.command("zoom-fit-page"); } }
            MenuItem { title: "Zoom to Selection"; shortcut: @keys(Control + "8"); enabled: root.has-rect-selection; activated => { root.command("zoom-to-selection"); } }
            MenuItem { title: "Zoom to Width"; enabled: root.has-document; activated => { root.command("zoom-fit-width"); } }
            MenuItem { title: "Zoom In"; shortcut: @keys(Control + "="); enabled: root.has-document; activated => { root.command("zoom-in"); } }
            MenuItem { title: "Zoom Out"; shortcut: @keys(Control + "-"); enabled: root.has-document; activated => { root.command("zoom-out"); } }
            MenuSeparator { }
            MenuItem { title: "Slideshow"; shortcut: @keys(Control + Shift + "f"); enabled: root.has-document; activated => { root.command("slideshow"); } }
            MenuItem { title: root.markup-visible ? "Hide Markup Toolbar" : "Show Markup Toolbar"; shortcut: @keys(Control + Shift + "a"); enabled: root.has-document; activated => { root.command("toggle-markup"); } }
            MenuSeparator { }
            Menu {
                title: "Appearance";
                MenuItem { title: "Use System Setting"; checkable: true; checked: Theme.appearance == "system"; activated => { root.command("appearance-system"); } }
                MenuItem { title: "Light"; checkable: true; checked: Theme.appearance == "light"; activated => { root.command("appearance-light"); } }
                MenuItem { title: "Dark"; checkable: true; checked: Theme.appearance == "dark"; activated => { root.command("appearance-dark"); } }
            }
        }
        Menu {
            title: "Go";
            MenuItem { title: "Previous Page"; shortcut: @keys(Control + Alt + UpArrow); enabled: root.has-document; activated => { root.command("page-prev"); } }
            MenuItem { title: "Next Page"; shortcut: @keys(Control + Alt + DownArrow); enabled: root.has-document; activated => { root.command("page-next"); } }
            MenuItem { title: "First Page"; enabled: root.has-document; activated => { root.command("page-first"); } }
            MenuItem { title: "Last Page"; enabled: root.has-document; activated => { root.command("page-last"); } }
            MenuSeparator { }
            MenuItem { title: "Go to Page…"; shortcut: @keys(Control + Alt + "g"); enabled: root.has-document && root.multi-page; activated => { root.command("go-to-page"); } }
            MenuSeparator { }
            MenuItem { title: root.page-bookmarked ? "Remove Bookmark" : "Add Bookmark"; shortcut: @keys(Control + "d"); enabled: root.has-file; activated => { root.command("toggle-bookmark"); } }
        }
        Menu {
            title: "Tools";
            MenuItem { title: "Text Selection"; checkable: true; checked: root.tool == "tool-text"; enabled: root.has-document; activated => { root.command("tool-text"); } }
            MenuItem { title: "Rectangular Selection"; checkable: true; checked: root.tool == "tool-rect"; enabled: root.has-document; activated => { root.command("tool-rect"); } }
            MenuSeparator { }
            Menu {
                title: "Annotate";
                enabled: root.has-document;
                MenuItem { title: "Highlight Text"; shortcut: @keys(Control + Alt + "h"); activated => { root.command("highlight"); } }
                MenuItem { title: "Underline Text"; shortcut: @keys(Control + Alt + "u"); activated => { root.command("underline"); } }
                MenuItem { title: "Strikethrough Text"; shortcut: @keys(Control + Alt + "k"); activated => { root.command("strikethrough"); } }
                MenuSeparator { }
                MenuItem { title: "Rectangle"; shortcut: @keys(Control + Alt + "r"); activated => { root.command("shape-rect"); } }
                MenuItem { title: "Oval"; shortcut: @keys(Control + Alt + "o"); activated => { root.command("shape-oval"); } }
                MenuItem { title: "Line"; shortcut: @keys(Control + Alt + "l"); activated => { root.command("shape-line"); } }
                MenuItem { title: "Arrow"; shortcut: @keys(Control + Alt + "a"); activated => { root.command("shape-arrow"); } }
                MenuItem { title: "Rounded Rectangle"; activated => { root.command("shape-rounded"); } }
                MenuItem { title: "Speech Bubble"; activated => { root.command("shape-bubble"); } }
                MenuItem { title: "Star"; activated => { root.command("shape-star"); } }
                MenuItem { title: "Loupe"; activated => { root.command("shape-lens"); } }
                MenuSeparator { }
                MenuItem { title: "Text"; shortcut: @keys(Control + Alt + "t"); activated => { root.command("tool-textbox"); } }
                MenuItem { title: "Note"; shortcut: @keys(Control + Alt + "n"); activated => { root.command("tool-note"); } }
                MenuItem { title: "Sketch"; activated => { root.command("tool-sketch"); } }
                MenuItem { title: "Draw"; activated => { root.command("tool-draw"); } }
            }
            MenuItem { title: "Redact"; shortcut: @keys(Control + Shift + "r"); enabled: root.has-document && !root.is-image; activated => { root.command("tool-redact"); } }
            MenuItem { title: "Signatures…"; enabled: root.has-document; activated => { root.command("tool-signature"); } }
            MenuSeparator { }
            MenuItem { title: "Rotate Left"; shortcut: @keys(Control + "l"); enabled: root.has-document; activated => { root.command("rotate-left"); } }
            MenuItem { title: "Rotate Right"; shortcut: @keys(Control + "r"); enabled: root.has-document; activated => { root.command("rotate-right"); } }
            MenuItem { title: "Crop"; shortcut: @keys(Control + "k"); enabled: root.has-rect-selection; activated => { root.command("crop"); } }
            MenuItem { title: "Flip Horizontal"; enabled: root.is-image; activated => { root.command("flip-horizontal"); } }
            MenuItem { title: "Flip Vertical"; enabled: root.is-image; activated => { root.command("flip-vertical"); } }
            MenuItem { title: "Flip Up Axis (3D)"; enabled: root.is-model; activated => { root.command("flip-up-axis"); } }
            MenuSeparator { }
            MenuItem { title: "Adjust Color…"; shortcut: @keys(Control + Alt + "c"); enabled: root.is-image; activated => { root.command("adjust-color"); } }
            MenuItem { title: "Adjust Size…"; enabled: root.is-image; activated => { root.command("adjust-size"); } }
            MenuItem { title: "Instant Alpha"; checkable: true; checked: root.tool == "tool-alpha"; enabled: root.is-image; activated => { root.command("instant-alpha"); } }
            MenuItem { title: root.location-shown ? "Hide Location" : "Show Location"; enabled: root.has-location && !root.location-removed; activated => { root.command("show-location"); } }
            MenuItem { title: "Remove Location Info"; enabled: root.has-location && !root.location-removed; activated => { root.command("remove-location"); } }
            MenuSeparator { }
            MenuItem { title: "Show Magnifier"; shortcut: @keys(Control + "`"); checkable: true; checked: root.loupe-on; enabled: root.has-document; activated => { root.command("toggle-loupe"); } }
            MenuItem { title: "Show Inspector"; shortcut: @keys(Control + "i"); checkable: true; checked: root.inspector-visible; enabled: root.has-document; activated => { root.command("inspector"); } }
        }
        Menu {
            title: "Window";
            MenuItem { title: "Minimize"; activated => { root.command("minimize"); } }
            MenuItem { title: "Zoom"; activated => { root.command("maximize"); } }
            MenuSeparator { }
            for t[i] in root.window-titles: MenuItem {
                title: t;
                checkable: true;
                checked: i == root.window-index;
                activated => { root.activate-window(i); }
            }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Keyboard Shortcuts"; shortcut: @keys(F1); activated => { root.command("shortcuts"); } }
            MenuItem { title: "Use Paper Mirror for PDFs and Images…"; activated => { root.command("register-file-types"); } }
            MenuItem { title: "Remove File Type Registration…"; activated => { root.command("unregister-file-types"); } }
            MenuSeparator { }
            MenuItem { title: "Third-party Notices"; activated => { root.command("show-notices"); } }
            MenuSeparator { }
            MenuItem { title: "About Paper Mirror"; activated => { root.command("about"); } }
        }
    }

    VerticalLayout {
        // Toolbar
        Rectangle {
            height: Theme.toolbar-height;
            background: Theme.toolbar-bg;
            accessible-role: groupbox;
            accessible-label: "Toolbar";
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 4px;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.sidebar;
                        tip: "Show or hide the sidebar (Ctrl+Alt+S)";
                        selected: root.sidebar-visible;
                        checkable: true;
                        clicked => { root.command("toggle-sidebar"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: 6px;
                    min-width: 100px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.has-document ? root.doc-title : "Paper Mirror";
                        font-weight: 600;
                        font-size: Theme.font-title;
                        color: Theme.text;
                        overflow: elide;
                        accessible-role: text;
                    }
                    if root.doc-subtitle != "": Text {
                        text: root.doc-subtitle;
                        font-size: Theme.font-small;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.info;
                        tip: "Show the inspector (Ctrl+I)";
                        enabled: root.has-document;
                        selected: root.inspector-visible;
                        checkable: true;
                        clicked => { root.command("inspector"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Segmented {
                        left-icon: Icons.zoom-out;
                        right-icon: Icons.zoom-in;
                        left-tip: "Zoom out (Ctrl+-)";
                        right-tip: "Zoom in (Ctrl+=)";
                        enabled: root.has-document;
                        left-clicked => { root.command("zoom-out"); }
                        right-clicked => { root.command("zoom-in"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.rotate-left;
                        tip: "Rotate left (Ctrl+L)";
                        enabled: root.has-document;
                        clicked => { root.command("rotate-left"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.highlight;
                        tip: "Highlight the selected text (Ctrl+Alt+H)";
                        enabled: root.has-document && !root.is-image && !root.is-model;
                        selected: root.tool == "tool-highlight";
                        checkable: true;
                        clicked => { root.command("highlight"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.markup;
                        tip: "Show or hide the Markup toolbar (Ctrl+Shift+A)";
                        enabled: root.has-document && !root.is-model;
                        selected: root.markup-visible;
                        checkable: true;
                        clicked => { root.command("toggle-markup"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.share;
                        tip: "Share";
                        enabled: root.has-document;
                        clicked => { root.command("share"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: 6px;
                    search := BridgedLineEdit {
                        width: 190px;
                        enabled: root.has-document && !root.is-model;
                        placeholder-text: "Search";
                        accessible-label: "Search document";
                        text <=> root.search-text;
                        accepted => { root.search-submitted(self.text); }
                        edited(t) => { root.search-edited(t); }
                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                self.text = "";
                                root.search-submitted("");
                                root.focus-canvas();
                                return accept;
                            }
                            if e.text == Key.F3 {
                                root.command(e.modifiers.shift ? "find-prev" : "find-next");
                                return accept;
                            }
                            reject
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.toolbar-border;
            }
        }

        if root.markup-visible && root.has-document && !root.is-model: MarkupBar {
            tool: root.tool;
            is-pdf: !root.is-image;
            has-text-selection: root.has-text-selection;
            stroke-color: root.markup-stroke;
            fill-color: root.markup-fill;
            fill-none: root.markup-fill-none;
            line-width: root.markup-line-width;
            dashed: root.markup-dashed;
            fonts: root.markup-fonts;
            font: root.markup-font;
            font-size: root.markup-font-size;
            text-color: root.markup-text-color;
            align: root.markup-align;
            command(id) => { root.command(id); }
            set-stroke(c) => { root.markup-set-stroke(c); }
            set-fill(c, n) => { root.markup-set-fill(c, n); }
            set-line(w, d) => { root.markup-set-line(w, d); }
            set-text-style(f, s, c, a) => { root.markup-set-text-style(f, s, c, a); }
        }

        HorizontalLayout {
            Rectangle {
                // A 3D model has no pages, so no sidebar.
                width: root.sidebar-visible && !root.is-model ? root.sidebar-width : 0px;
                visible: root.sidebar-visible && !root.is-model;
                background: Theme.sidebar-bg;
                VerticalLayout {
                    SidebarTabs {
                        mode: root.sidebar-mode;
                        has-search: root.has-search;
                        mode-selected(m) => { root.sidebar-mode-selected(m); }
                    }
                    if root.sidebar-mode == "search" && root.search-status != "": Text {
                        text: root.search-status;
                        font-size: Theme.font-small;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        height: 22px;
                        vertical-alignment: center;
                        accessible-role: text;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        thumbs := ThumbnailList {
                            visible: root.sidebar-mode == "thumbnails";
                            items: root.thumbs;
                            content-height: root.thumbs-content-height;
                            viewport-changed => { root.thumbs-viewport-changed(); }
                            item-clicked(i, c, s) => { root.thumb-clicked(i, c, s); }
                            key(e) => { return root.thumbs-key(e); }
                            item-drag(i, y) => { root.thumb-drag(i, y); }
                            item-drop => { root.thumb-drop(); }
                            context-command(id) => { root.command(id); }
                            drop-visible: root.thumb-drop-visible;
                            drop-y: root.thumb-drop-y;
                        }
                        if root.sidebar-mode == "contents": RowList {
                            rows: root.outline-rows;
                            label: "Table of contents";
                            empty-text: "This document has no table of contents.";
                            row-clicked(id) => { root.list-row-clicked("contents", id); }
                            row-toggled(id) => { root.list-row-toggled("contents", id); }
                        }
                        if root.sidebar-mode == "bookmarks": RowList {
                            rows: root.bookmark-rows;
                            label: "Bookmarks";
                            empty-text: "No bookmarks. Choose Go > Add Bookmark (Ctrl+D) to mark the current page.";
                            row-clicked(id) => { root.list-row-clicked("bookmarks", id); }
                        }
                        if root.sidebar-mode == "notes": RowList {
                            rows: root.note-rows;
                            label: "Highlights and notes";
                            empty-text: "No highlights or notes yet.";
                            row-clicked(id) => { root.list-row-clicked("notes", id); }
                        }
                        if root.sidebar-mode == "search": RowList {
                            rows: root.search-rows;
                            label: "Search results";
                            empty-text: "No matches.";
                            row-clicked(id) => { root.list-row-clicked("search", id); }
                        }
                    }
                }
            }
            if root.sidebar-visible && !root.is-model: Rectangle {
                width: 1px;
                background: Theme.separator;
                accessible-role: none;
                TouchArea {
                    x: -3px;
                    width: 7px;
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, Theme.sidebar-min, Theme.sidebar-max);
                        }
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up { root.sidebar-resized(); }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                canvas := Canvas {
                    visible: !root.contact-sheet;
                    pages: root.pages;
                    overlays: root.overlays;
                    content-width: root.content-width;
                    content-height: root.content-height;
                    has-document: root.has-document;
                    cursor: root.canvas-cursor;
                    loupe-visible: root.loupe-visible;
                    loupe-image: root.loupe-image;
                    loupe-x: root.loupe-x;
                    loupe-y: root.loupe-y;
                    zoom-on-wheel: root.is-model;
                    mask-visible: root.mask-visible;
                    mask-image: root.mask-image;
                    mask-x: root.mask-x;
                    mask-y: root.mask-y;
                    mask-w: root.mask-w;
                    mask-h: root.mask-h;
                    empty-title: "Open a PDF or image";
                    empty-detail: "Choose File > Open, press Ctrl+O, or drag a file into this window.";
                    viewport-changed => { root.canvas-viewport-changed(); }
                    ctrl-wheel(d, x, y) => { root.canvas-ctrl-wheel(d, x, y); }
                    pinch(p, s, x, y) => { root.canvas-pinch(p, s, x, y); }
                    touch-draws: root.is-model || root.tool != "tool-text";
                    key(e) => { return root.canvas-key(e); }
                    pointer(k, x, y, s, c, b) => { root.canvas-pointer(k, x, y, s, c, b); }
                    can-copy: root.has-text-selection || root.has-rect-selection;
                    annot-prims: root.annot-prims;
                    annot-selected: root.annot-selected;
                    annot-resizable: root.annot-resizable;
                    sel-x: root.sel-x;
                    sel-y: root.sel-y;
                    sel-w: root.sel-w;
                    sel-h: root.sel-h;
                    editing: root.editing;
                    edit-note: root.edit-note;
                    edit-x: root.edit-x;
                    edit-y: root.edit-y;
                    edit-w: root.edit-w;
                    edit-h: root.edit-h;
                    edit-text <=> root.edit-text;
                    edit-font-size: root.edit-font-size;
                    edit-font: root.edit-font;
                    edit-color: root.edit-color;
                    edit-align: root.edit-align;
                    edit-finished(t) => { root.edit-finished(t); }
                    form-fields: root.form-fields;
                    field-commit-text(i, t) => { root.field-commit-text(i, t); }
                    field-toggle(i) => { root.field-toggle(i); }
                    field-choose(i, o) => { root.field-choose(i, o); }
                    field-sign(i) => { root.field-sign(i); }
                    context-command(id) => { root.command(id); }
                }
                sheet := ContactSheet {
                    visible: root.contact-sheet;
                    items: root.sheet-items;
                    content-height: root.sheet-content-height;
                    viewport-changed => { root.sheet-viewport-changed(); }
                    item-clicked(i) => { root.sheet-item-clicked(i); }
                    item-opened(i) => { root.sheet-item-opened(i); }
                }
            }
            if root.inspector-visible: InspectorPanel {
                rows: root.info-rows;
                has-location: root.has-location;
                location-shown: root.location-shown;
                location-removed: root.location-removed;
                closed => { root.command("inspector"); }
                command(id) => { root.command(id); }
            }
        }
    }

    if root.busy-text != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 56px;
        width: busy-label.preferred-width + 28px;
        height: 30px;
        border-radius: 15px;
        background: Theme.dark ? #3a3a3aee : #303030e6;
        busy-label := Text { text: root.busy-text; color: white; font-size: Theme.font-size; }
    }

    if root.prompt-kind != "" || root.shortcuts-visible || root.signatures-visible || root.export-visible || root.size-visible: Scrim { }

    if root.adjust-visible: AdjustColorPanel {
        x: root.width - self.width - 16px;
        y: Theme.toolbar-height + 16px;
        black <=> root.adjust-black;
        white <=> root.adjust-white;
        exposure <=> root.adjust-exposure;
        contrast <=> root.adjust-contrast;
        saturation <=> root.adjust-saturation;
        temperature <=> root.adjust-temperature;
        tint <=> root.adjust-tint;
        sepia <=> root.adjust-sepia;
        sharpness <=> root.adjust-sharpness;
        changed => { root.adjust-changed(); }
        auto-levels => { root.adjust-auto(); }
        reset => { root.adjust-reset(); }
        done => { root.adjust-done(); }
    }

    if root.size-visible: AdjustSizePanel {
        x: (root.width - self.width) / 2;
        y: max(30px, (root.height - self.height) / 3);
        units: root.size-units;
        unit <=> root.size-unit;
        width-text <=> root.size-width;
        height-text <=> root.size-height;
        resolution <=> root.size-resolution;
        proportional <=> root.size-proportional;
        resample <=> root.size-resample;
        size-editable: root.size-editable;
        result: root.size-result;
        edited(f) => { root.size-edited(f); }
        confirm => { root.size-confirm(); }
        cancel => { root.size-cancel(); }
    }

    if root.export-visible: ExportPanel {
        x: (root.width - self.width) / 2;
        y: max(30px, (root.height - self.height) / 3);
        title: root.export-title;
        formats: root.export-formats;
        format <=> root.export-format;
        is-pdf: root.export-is-pdf;
        has-quality: root.export-has-quality;
        quality <=> root.export-quality;
        has-resolution: root.export-has-resolution;
        resolution <=> root.export-resolution;
        format-changed => { root.export-format-changed(); }
        effects: root.export-effects;
        effect <=> root.export-effect;
        reduce <=> root.export-reduce;
        encrypt <=> root.export-encrypt;
        flatten <=> root.export-flatten;
        password <=> root.export-password;
        password2 <=> root.export-password2;
        error: root.export-error;
        confirm => { root.export-confirm(); }
        cancel => { root.export-visible = false; root.focus-canvas(); }
    }

    if root.signatures-visible: SignaturesPanel {
        x: (root.width - self.width) / 2;
        y: max(30px, (root.height - self.height) / 3);
        signatures: root.signatures;
        drawing: root.sig-drawing;
        pad-commands: root.pad-commands;
        new-name <=> root.sig-name;
        chosen(id) => { root.signature-chosen(id); }
        delete(id) => { root.signature-delete(id); }
        start-drawing => { root.signature-start-drawing(); }
        import-image => { root.signature-import(); }
        pad-pointer(k, x, y) => { root.pad-pointer(k, x, y); }
        pad-clear => { root.pad-clear(); }
        pad-save => { root.pad-save(); }
        closed => { root.signatures-closed(); }
    }

    if root.prompt-kind != "": PromptPanel {
        x: (root.width - self.width) / 2;
        y: max(40px, (root.height - self.height) / 3);
        heading: root.prompt-heading;
        message: root.prompt-message;
        error: root.prompt-error;
        password: root.prompt-password;
        accept-label: root.prompt-accept-label;
        value <=> root.prompt-value;
        accepted(v) => { root.prompt-accepted(root.prompt-kind, v); }
        cancelled => { root.prompt-cancelled(root.prompt-kind); }
        init => { self.focus-input(); }
    }

    if root.shortcuts-visible: ShortcutsPanel {
        x: (root.width - self.width) / 2;
        y: max(20px, (root.height - self.height) / 2);
        rows: root.shortcut-rows;
        closed => { root.shortcuts-visible = false; root.focus-canvas(); }
    }

    // Tooltip overlay, drawn last so it sits above every panel.
    if Tooltip.shown: Rectangle {
        x: min(Tooltip.x, root.width - self.width - 4px);
        y: Tooltip.y;
        width: tip-text.preferred-width + 14px;
        height: tip-text.preferred-height + 8px;
        border-radius: 4px;
        background: Theme.dark ? #3a3a3a : #fafafa;
        border-width: 1px;
        border-color: Theme.separator;
        tip-text := Text {
            text: Tooltip.text;
            font-size: Theme.font-small;
            color: Theme.text;
        }
    }

    about := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 350px) / 2;
        width: 360px;
        height: 350px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.separator;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text { text: "Paper Mirror"; font-size: 18px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Text { text: "Version " + root.app-version; color: Theme.text-secondary; horizontal-alignment: center; }
                Text {
                    text: "A lightweight PDF and image viewer for Windows, inspired by macOS Preview. Not affiliated with or endorsed by Apple.";
                    wrap: word-wrap;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "© 2026 Robert Venning. Released under the MIT License.";
                    wrap: word-wrap;
                    font-size: Theme.font-small;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                AboutSlint { }
                HorizontalLayout {
                    alignment: center;
                    PlainButton { text: "Third-party notices"; clicked => { root.command("show-notices"); } }
                }
            }
        }
    }

    public function show-about() {
        about.show();
    }

    // Slint's own widgets follow the app's light/dark choice, not just Windows'.
    public function set-widget-scheme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function scroll-canvas-to(x: length, y: length) {
        canvas.scroll-to(x, y);
    }

    public function scroll-thumbs-to(y: length) {
        thumbs.scroll-to(y);
    }

    public function focus-canvas() {
        canvas.focus-canvas();
    }

    public function focus-search() {
        search.focus();
        search.select-all();
    }
}
