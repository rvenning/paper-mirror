// Form-field overlays and the Signatures panel.
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlainButton, BridgedTextInput, IconButton } from "controls.slint";
import { Icons } from "icons.slint";

// kind: "text", "check", "radio", "choice", "signature".
export struct FormFieldView {
    index: int,
    kind: string,
    x: length,
    y: length,
    width: length,
    height: length,
    value: string,
    options: [string],
    selected: int,
    checked: bool,
    read-only: bool,
    multiline: bool,
    password: bool,
    label: string,
}

export struct SignatureView {
    id: int,
    name: string,
    commands: string,
    aspect: float,
    chosen: bool,
}

// Transparent until focused, so PDFium's own rendering of the value shows through.
component FormTextField inherits Rectangle {
    in property <FormFieldView> field;
    callback commit(text: string);
    background: input.has-focus ? white : transparent;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    input := BridgedTextInput {
        x: 2px;
        width: parent.width - 4px;
        height: parent.height;
        text: root.field.value;
        color: self.has-focus ? black : transparent;
        font-size: max(8px, min(root.field.height * 0.62, 16px));
        vertical-alignment: root.field.multiline ? top : center;
        single-line: !root.field.multiline;
        wrap: root.field.multiline ? word-wrap : no-wrap;
        read-only: root.field.read-only;
        input-type: root.field.password ? InputType.password : InputType.text;
        accessible-label: root.field.label;
        accepted => { root.commit(self.text); }
        changed has-focus => {
            if !self.has-focus { root.commit(self.text); }
        }
    }
}

component FormToggle inherits Rectangle {
    in property <FormFieldView> field;
    callback toggle();
    border-radius: field.kind == "radio" ? self.width / 2 : 2px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus-ring;
    accessible-role: checkbox;
    accessible-label: field.label;
    accessible-checkable: true;
    accessible-checked: field.checked;
    accessible-action-default => { if !root.field.read-only { root.toggle(); } }
    TouchArea {
        enabled: !root.field.read-only;
        clicked => { focus.focus(); root.toggle(); }
    }
    focus := FocusScope {
        // Clicks belong to the controls underneath, which take focus themselves; a
        // FocusScope that focuses on click would swallow the first press.
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " && !root.field.read-only { root.toggle(); return accept; }
            reject
        }
    }
}

export component FormLayer inherits Rectangle {
    in property <[FormFieldView]> fields;
    callback commit-text(index: int, text: string);
    callback toggle(index: int);
    callback choose(index: int, option: int);
    callback sign(index: int);
    for f in root.fields: Rectangle {
        x: f.x;
        y: f.y;
        width: f.width;
        height: f.height;
        if f.kind == "text": FormTextField {
            field: f;
            commit(t) => { root.commit-text(f.index, t); }
        }
        if f.kind == "check" || f.kind == "radio": FormToggle {
            field: f;
            toggle => { root.toggle(f.index); }
        }
        if f.kind == "choice": Rectangle {
            // Opaque, so the page's own rendering of the value does not show through.
            background: white;
            ComboBox {
                width: parent.width;
                height: max(parent.height, 22px);
                model: f.options;
                current-index: f.selected;
                enabled: !f.read-only;
                accessible-label: f.label;
                selected(v) => { root.choose(f.index, self.current-index); }
            }
        }
        if f.kind == "signature": Rectangle {
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.accent.with-alpha(0.08);
            accessible-role: button;
            accessible-label: f.label == "" ? "Sign here" : f.label;
            accessible-action-default => { root.sign(f.index); }
            Text { text: "Sign"; color: Theme.accent; font-size: 11px; }
            TouchArea { mouse-cursor: pointer; clicked => { root.sign(f.index); } }
        }
    }
}

export component SignaturesPanel inherits Rectangle {
    in property <[SignatureView]> signatures;
    in property <bool> drawing;
    in property <string> pad-commands;
    in-out property <string> new-name;
    callback chosen(id: int);
    callback delete(id: int);
    callback start-drawing();
    callback import-image();
    callback pad-pointer(kind: int, x: length, y: length);
    callback pad-clear();
    callback pad-save();
    callback closed();
    width: 480px;
    height: 400px;
    background: Theme.panel-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.separator;
    accessible-role: groupbox;
    accessible-label: "Signatures";
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: root.drawing ? "Create a Signature" : "Signatures"; font-size: 15px; font-weight: 600; color: Theme.text; }
        if !root.drawing: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                if root.signatures.length == 0: Text {
                    text: "You have no saved signatures. Create one by drawing it with your mouse, pen or finger, or import a photo or scan of your signature.";
                    wrap: word-wrap;
                    color: Theme.text-secondary;
                }
                for s in root.signatures: Rectangle {
                    height: 64px;
                    border-radius: 6px;
                    background: s.chosen ? Theme.control-selected : sig-touch.has-hover ? Theme.control-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Use signature " + s.name;
                    accessible-action-default => { root.chosen(s.id); }
                    sig-touch := TouchArea { clicked => { root.chosen(s.id); } }
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 180px;
                            background: white;
                            border-radius: 4px;
                            Path {
                                x: 6px;
                                y: 6px;
                                width: parent.width - 12px;
                                height: parent.height - 12px;
                                commands: s.commands;
                                stroke: #1d1d1d;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                            }
                        }
                        Text { text: s.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout {
                            alignment: center;
                            IconButton { icon: Icons.trash; tip: "Delete this signature"; clicked => { root.delete(s.id); } }
                        }
                    }
                }
            }
        }
        if root.drawing: Rectangle {
            vertical-stretch: 1;
            background: white;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.field-border;
            accessible-role: image;
            accessible-label: "Signature drawing area";
            Rectangle { x: 20px; y: parent.height - 40px; width: parent.width - 40px; height: 1px; background: #c0c0c0; }
            Text { x: 20px; y: parent.height - 34px; text: "Sign above the line"; font-size: 11px; color: #8a8a8a; }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: parent.width / 1px;
                viewbox-height: parent.height / 1px;
                commands: root.pad-commands;
                stroke: #1d1d1d;
                stroke-width: 2.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
            TouchArea {
                mouse-cursor: crosshair;
                pointer-event(e) => {
                    root.pad-pointer(e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.move ? 1 : 2, self.mouse-x, self.mouse-y);
                }
            }
        }
        if root.drawing: HorizontalLayout {
            spacing: 8px;
            Text { text: "Name"; color: Theme.text-secondary; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.field-border;
                background: Theme.field-bg;
                BridgedTextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    text <=> root.new-name;
                    color: Theme.text;
                    vertical-alignment: center;
                    accessible-label: "Signature name";
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if !root.drawing: PlainButton { text: "Import Image…"; clicked => { root.import-image(); } }
            if !root.drawing: PlainButton { text: "Create Signature…"; clicked => { root.start-drawing(); } }
            if root.drawing: PlainButton { text: "Clear"; clicked => { root.pad-clear(); } }
            if root.drawing: PlainButton { text: "Save"; primary: true; enabled: root.pad-commands != ""; clicked => { root.pad-save(); } }
            PlainButton { text: root.drawing ? "Cancel" : "Close"; clicked => { root.closed(); } }
        }
    }
}
